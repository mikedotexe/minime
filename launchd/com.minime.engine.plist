<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.minime.engine</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/v/other/minime/scripts/launchd_minime_engine.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>EIGENFILL_TARGET</key>
		<string>0.68</string>
		<key>MINIME_HARD_RECOVERY_RESET</key>
		<string>1</string>
		<key>LEGACY_AUDIO_ENABLED</key>
		<string>false</string>
		<key>LEGACY_VIDEO_ENABLED</key>
		<string>false</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/v/other/minime</string>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/Users/v/other/minime/logs/minime-engine.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/v/other/minime/logs/minime-engine.log</string>
</dict>
</plist>
