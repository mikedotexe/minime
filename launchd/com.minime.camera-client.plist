<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.minime.camera-client</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>-u</string>
		<string>/Users/v/other/minime/minime/tools/camera_client.py</string>
		<string>--camera</string>
		<string>0</string>
		<string>--fps</string>
		<string>0.2</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/v/other/minime/minime</string>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/v/other/minime/logs/camera-client.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/v/other/minime/logs/camera-client.log</string>
</dict>
</plist>
