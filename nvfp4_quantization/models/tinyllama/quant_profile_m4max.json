{
  "name": "tinyllama-m4max",
  "description": "Optimized for M4 Max with Metal acceleration",
  "quantization": {
    "type": "nvfp4",
    "tile_size": 16,
    "keep_fp16_layers": [
      "model.embed_tokens",
      "model.norm",
      "lm_head"
    ],
    "keep_fp16_percent": 0.15
  },
  "optimization": {
    "use_metal": true,
    "threadgroup_size": [16, 16],
    "batch_size": 8,
    "kv_cache_dtype": "fp16"
  }
}
