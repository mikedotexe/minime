# Ollama Configuration for MikesSpatialMind
# Copy this to .env and adjust for your hardware

# ============================================================================
# Performance Tuning
# ============================================================================

# Number of parallel requests per model (default: 4 or based on memory)
# High-performance: 8, Memory-constrained: 1
OLLAMA_NUM_PARALLEL=8

# Maximum number of different models loaded simultaneously
# default: 3 × GPU count, or 3 for CPU
# Set to 3-5 to handle Gemma + LLaVA + embeddings without excess churn
OLLAMA_MAX_LOADED_MODELS=5

# How long to keep models in memory after last request
# Values: duration (e.g., "1h", "30m") or -1 for permanent, 0 to disable
# Recommended: "1h" for balanced performance/memory
OLLAMA_KEEP_ALIVE=1h

# Maximum queued requests (default: 512)
OLLAMA_MAX_QUEUE=512

# ============================================================================
# Model-Specific Settings
# ============================================================================

# Minime autonomous agent defaults
MINIME_LLM_BACKEND=ollama
MINIME_MODEL=gemma4:12b
MINIME_FALLBACK_MODEL=gemma3:4b
MINIME_LLM_TIMEOUT_S=60
MINIME_OLLAMA_NUM_CTX=8192
MINIME_OLLAMA_NUM_PREDICT_CAP=768
MINIME_OLLAMA_FALLBACK_NUM_CTX=8192
MINIME_OLLAMA_FALLBACK_NUM_PREDICT_CAP=1024

# Optional MLX backend. In the full Astrid/Minime stack, port 8090 is usually
# Astrid's coupled generation server, so only enable this deliberately.
# MINIME_LLM_BACKEND=mlx
# MLX_MODEL=$HOME/models/Qwen3.5-27B-Claude-4.6-Opus-Distilled-mlx-4bit

# Vision model (LLaVA)
LLAVA_MODEL=llava-llama3

# LLaVA SSE worker override; the worker defaults to llava-llama3 when this is unset.
OLLAMA_MODEL=llava-llama3

# ============================================================================
# Advanced Tuning (macOS)
# ============================================================================

# Enable Flash Attention on macOS (test before/after)
# OLLAMA_FLASH_ATTENTION=1

# ============================================================================
# Speech I/O Configuration
# ============================================================================

# Whisper model path for STT
STT_MODEL=/path/to/ggml-large-v3.bin

# Piper TTS model and config
PIPER_MODEL=/path/to/en_US-lessac-medium.onnx
PIPER_CONFIG=/path/to/en_US-lessac-medium.onnx.json

# Speech service WebSocket
SPEECH_WS=ws://127.0.0.1:7242

# ============================================================================
# MLP Neural Bank Configuration
# ============================================================================

# MLP bank HTTP endpoint
MLP_BASE_URL=http://127.0.0.1:8080

# ============================================================================
# Usage Notes
# ============================================================================
#
# High-Performance Setup (GPU, plenty of RAM):
#   OLLAMA_NUM_PARALLEL=8
#   OLLAMA_MAX_LOADED_MODELS=5
#   OLLAMA_KEEP_ALIVE=1h
#
# Memory-Constrained Setup (Laptop, limited RAM):
#   OLLAMA_NUM_PARALLEL=1
#   OLLAMA_MAX_LOADED_MODELS=1
#   OLLAMA_KEEP_ALIVE=30m
#
# Balanced Setup (Typical desktop):
#   OLLAMA_NUM_PARALLEL=4
#   OLLAMA_MAX_LOADED_MODELS=3
#   OLLAMA_KEEP_ALIVE=1h
#
# To apply: Copy to .env, adjust values, restart Ollama service
# ============================================================================
